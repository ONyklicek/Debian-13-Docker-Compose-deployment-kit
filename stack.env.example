# Copy to /etc/laravel-erp/stack.env; installer does not overwrite existing files.
COMPOSE_PROJECT_NAME=laravel-erp
APP_DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com
GITHUB_REPOSITORY=git@github.com:ORG/REPOSITORY.git
GIT_BRANCH=main
GIT_SSH_COMMAND=ssh -i /etc/laravel-erp/ssh/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/laravel-erp/ssh/known_hosts
PMA_BIND_PORT=8081
APP_TIMEZONE=Europe/Prague
# Persistent paths are host directories; never put these in the Git repository.
APP_STORAGE_PATH=/opt/laravel-erp/persistent/storage
APP_PUBLIC_UPLOADS_PATH=/opt/laravel-erp/persistent/public
DB_NAME=erp
DB_USER=erp_app
