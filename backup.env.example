# Copy to /etc/laravel-erp/backup.env and set chmod 0600.
# Configure a repository OUTSIDE this server. Examples:
# RESTIC_REPOSITORY=sftp:backup-user@backup.example.net:/srv/restic/laravel-erp
# RESTIC_REPOSITORY=s3:https://s3.example.net/bucket/laravel-erp
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# For S3-compatible storage, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
