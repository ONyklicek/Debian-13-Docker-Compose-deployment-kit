# Zkopírujte do /etc/dkit/backup.env (chmod 0600). Repozitář musí být MIMO tento server.
# RESTIC_REPOSITORY=sftp:backup-user@backup.example.net:/srv/restic/dkit
# RESTIC_REPOSITORY=s3:https://s3.example.net/bucket/dkit
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Pro S3-kompatibilní úložiště:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Název hostitele v restic snapshotech (výchozí: hostname serveru)
# BACKUP_HOST=
