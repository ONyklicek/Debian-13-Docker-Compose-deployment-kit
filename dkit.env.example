# Globální nastavení dkit (/etc/dkit/dkit.env). Instalátor existující soubor nepřepisuje.

# E-mail pro Let's Encrypt (povinné)
ACME_EMAIL=admin@example.com
# Pro testování lze použít staging CA:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TZ=Europe/Prague

# Web UI: výchozí jen loopback (přístup přes SSH tunel). UI ovládá Docker = root na serveru.
UI_BIND=127.0.0.1
UI_PORT=9000
# Volitelně veřejná doména pro UI přes Traefik (HTTPS + token). Zvažte rizika.
UI_DOMAIN=

# Výchozí image služeb (lze přepsat v app.env každé aplikace)
TRAEFIK_IMAGE=traefik:v3.5
MARIADB_IMAGE=mariadb:11.4
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
S3_IMAGE=chrislusf/seaweedfs:3.97
# Další parametry SeaweedFS (S3), např. -volume.minFreeSpace=5GiB
S3_ARGS=
ADMINER_IMAGE=adminer:5
ADMINER_PORT=8081

# Sdílené služby pro všechny aplikace (šetří RAM při mnoha webech): mariadb postgres s3
# Každá aplikace dostane vlastní databázi, uživatele a bucket. Přepsatelné v app.env (SHARED_SERVICES=).
SHARED_SERVICES=
# Nechat předchozí verzi webu běžet pro okamžitý rollback (1) nebo ji zastavit a šetřit RAM (0)
KEEP_PREVIOUS=1
# Privátní subnety aplikací (Docker má bez toho limit ~30 sítí). /16 rozdělené na /26 = 1024 aplikací.
APP_SUBNET_POOL=10.210.0.0/16
APP_SUBNET_PREFIX=26

# Kolik posledních image každé aplikace ponechat (aktivní a předchozí se nemažou nikdy)
KEEP_IMAGES=3
# HSTS v sekundách (0 = vypnuto)
HSTS_SECONDS=31536000
# Při buildu stahovat aktuální základní image (bezpečnostní záplaty). 0 = jen z lokální cache.
BUILD_PULL=1
