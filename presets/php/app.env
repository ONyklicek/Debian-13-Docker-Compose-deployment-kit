# PHP (Symfony, Nette, WordPress, čisté PHP): nginx + PHP-FPM, MariaDB
# Nastavení kitu pro aplikaci __APP__; proměnné prostředí aplikace jsou v souboru "env".
DOMAINS=__DOMAINS__
SOURCE=git
GIT_REPOSITORY=__REPO__
GIT_BRANCH=__BRANCH__
BUILD=php
# DOCROOT je adresář webu v repozitáři (public, www, web, .)
TEMPLATE_ARGS="DOCROOT=public"
BUILD_ARGS=
WEB_PORT=8080
HEALTH_PATH=/
SERVICES="mariadb"
WORKERS=
PERSIST=
PERSIST_OWNER=33:33
MIGRATE_CMD=
