# Statický web nebo SPA: volitelný npm build, nginx
# Nastavení kitu pro aplikaci __APP__; proměnné prostředí aplikace jsou v souboru "env".
DOMAINS=__DOMAINS__
SOURCE=git
GIT_REPOSITORY=__REPO__
GIT_BRANCH=__BRANCH__
BUILD=static
# STATIC_DIR = výstup buildu (dist, build, out) nebo "." pro čisté HTML; SPA=1 pro fallback na index.html
TEMPLATE_ARGS="STATIC_DIR=dist SPA=0"
BUILD_ARGS=
WEB_PORT=8080
HEALTH_PATH=/
SERVICES=
WORKERS=
