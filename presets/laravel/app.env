# Laravel: nginx + PHP-FPM, MariaDB, Redis, scheduler a queue worker, migrace
# Nastavení kitu pro aplikaci __APP__; proměnné prostředí aplikace jsou v souboru "env".
DOMAINS=__DOMAINS__
SOURCE=git
GIT_REPOSITORY=__REPO__
GIT_BRANCH=__BRANCH__

# Šablona build/php (nginx + PHP-FPM). Pro vlastní Dockerfile v repozitáři: BUILD=dockerfile
BUILD=php
# Např.: TEMPLATE_ARGS="PHP_VERSION=8.3 PHP_EXTENSIONS=imagick APT_PACKAGES=ffmpeg"
TEMPLATE_ARGS=
# Proměnné z "env", které se předají frontend buildu (Vite)
BUILD_ARGS="VITE_APP_NAME"
WEB_PORT=8080
HEALTH_PATH=/up

# Kontejnery služeb: mariadb postgres redis s3
SERVICES="mariadb redis"

# Workery (dlouho běžící procesy z téhož image). Pro Horizon/Reverb odkomentujte níže.
WORKERS="scheduler queue"
WORKER_scheduler_CMD="php artisan schedule:work"
WORKER_scheduler_USER=www-data
WORKER_queue_CMD="php artisan queue:work --sleep=3 --tries=3 --max-time=3600"
WORKER_queue_USER=www-data
# WORKERS="scheduler horizon reverb"
# WORKER_horizon_CMD="php artisan horizon"
# WORKER_horizon_USER=www-data
# WORKER_reverb_CMD="php artisan reverb:start --host=0.0.0.0 --port=8080"
# WORKER_reverb_USER=www-data
# WORKER_reverb_PORT=8080
# WORKER_reverb_PATH=/app

# Perzistentní adresáře (jméno:/cesta/v/kontejneru) a jejich vlastník při vytvoření
PERSIST="storage:/var/www/html/storage"
PERSIST_OWNER=33:33

# Migrace se spouští před přepnutím provozu jen s --migrate (nebo AUTO_MIGRATE=1)
MIGRATE_CMD="php artisan migrate --force && php artisan optimize"
MIGRATE_USER=www-data
AUTO_MIGRATE=0
