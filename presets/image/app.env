# Hotový image z registru (Gitea, n8n, Uptime Kuma, vlastní image…)
# Nastavení kitu pro aplikaci __APP__; proměnné prostředí aplikace jsou v souboru "env".
# Vhodné pro Gitea, Uptime Kuma, n8n, Metabase, vlastní image z GHCR atd.
DOMAINS=__DOMAINS__
SOURCE=image
IMAGE=__IMAGE__
WEB_PORT=8080
HEALTH_PATH=/
SERVICES=
WORKERS=
# Perzistentní data, např. PERSIST="data:/data"
PERSIST=
PERSIST_OWNER=
