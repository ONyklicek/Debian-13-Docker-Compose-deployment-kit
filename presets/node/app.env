# Nastavení kitu pro aplikaci __APP__ (preset: node — Express, Next.js, Nuxt, NestJS…)
# Aplikace musí poslouchat na $PORT (3000). Pro Next.js doporučeno "output: standalone" nebo npm start.
DOMAINS=__DOMAINS__
SOURCE=git
GIT_REPOSITORY=__REPO__
GIT_BRANCH=__BRANCH__
BUILD=node
TEMPLATE_ARGS="NODE_VERSION=22"
# Proměnné z "env" pro build (např. NEXT_PUBLIC_*)
BUILD_ARGS=
WEB_PORT=3000
HEALTH_PATH=/
SERVICES="postgres"
WORKERS=
# WORKERS="jobs"
# WORKER_jobs_CMD="node dist/worker.js"
PERSIST=
PERSIST_OWNER=1000:1000
# MIGRATE_CMD="npx prisma migrate deploy"
MIGRATE_CMD=
