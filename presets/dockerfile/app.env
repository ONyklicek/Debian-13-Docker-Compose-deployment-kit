# Nastavení kitu pro aplikaci __APP__ (preset: dockerfile — libovolný jazyk, Dockerfile v repozitáři)
DOMAINS=__DOMAINS__
SOURCE=git
GIT_REPOSITORY=__REPO__
GIT_BRANCH=__BRANCH__
BUILD=dockerfile
DOCKERFILE=Dockerfile
# Názvy proměnných z "env" předané jako --build-arg (a jako secret "buildenv")
BUILD_ARGS=
# Port, na kterém kontejner poslouchá, a cesta pro kontrolu zdraví (musí vracet 2xx/3xx)
WEB_PORT=8080
HEALTH_PATH=/
# WEB_CMD="./server --port 8080"   (přepíše CMD z image)
SERVICES=
WORKERS=
# WORKERS="worker"
# WORKER_worker_CMD="./worker"
PERSIST=
# PERSIST="uploads:/app/uploads"
# PERSIST_OWNER=1000:1000
MIGRATE_CMD=
